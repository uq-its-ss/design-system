{
  "name": "@uqds/app-maps",
  "version": "4.0.6-alpha.0",
  "description": "Application stylesheets for UQ Maps",
  "private": true,
  "keywords": [
    "uqds",
    "uq",
    "University of Queensland",
    "design system",
    "scss",
    "sass",
    "css",
    "application",
    "maps"
  ],
  "author": {
    "name": "University of Queensland",
    "url": "https://about.uq.edu.au/web-feedback?r=https://design-system.uq.edu.au"
  },
  "homepage": "https://github.com/uq-its-ss/design-system#readme",
  "license": "ISC",
  "directories": {
    "lib": "src"
  },
  "files": [
    "dist/*",
    "src/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uq-its-ss/design-system.git"
  },
  "scripts": {
    "build-icons": "tsx scripts/build-icons.ts",
    "build-css": "node scripts/build-css.js",
    "build": "tsx scripts/build-icons.ts && node scripts/build-css.js && npm run format",
    "format": "prettier --write \"src/**/*.{scss,js,ts}\"",
    "prepare": "gulp -f ../../gulpfile.js --cwd=. prepare"
  },
  "bugs": {
    "url": "https://github.com/uq-its-ss/design-system/issues"
  },
  "dependencies": {
    "@material/circular-progress": "^14.0.0",
    "@uqds/body": "^4.0.5",
    "@uqds/core": "^5.0.2",
    "@uqds/icon": "^5.0.1-alpha.0"
  },
  "devDependencies": {
    "@svgdotjs/svg.js": "^3.2.8",
    "chalk": "^4.1.2",
    "glob": "^7.2.3",
    "js-yaml": "^3.15.2",
    "mini-svg-data-uri": "^1.4.4",
    "sass": "^1.104.0",
    "svgdom": "0.1.28",
    "svgo": "^4.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
