{
  "name": "@uqds/icon",
  "version": "5.0.1-alpha.0",
  "description": "Icon component",
  "keywords": [
    "uqds",
    "uq",
    "University of Queensland",
    "design system",
    "scss",
    "sass",
    "css",
    "icon"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "University of Queensland",
    "url": "https://about.uq.edu.au/web-feedback?r=https://design-system.uq.edu.au"
  },
  "homepage": "https://github.com/uq-its-ss/design-system#readme",
  "license": "ISC",
  "main": "index.js",
  "directories": {
    "lib": "src"
  },
  "files": [
    "index.js",
    "dist/css/*",
    "dist/images/*",
    "src/js/_build/*",
    "src/scss/*",
    "src/ts/_build/*"
  ],
  "exports": {
    ".": {
      "types": "./src/ts/_build/_icons.d.ts",
      "import": "./index.js",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./build-utils": {
      "types": "./src/ts/build-utils/index.ts",
      "import": "./src/ts/build-utils/index.ts",
      "default": "./src/ts/build-utils/index.ts"
    },
    "./dist/css/main.css": "./dist/css/main.css",
    "./src/js/_build/*": "./src/js/_build/*.js",
    "./src/scss/*": "./src/scss/*"
  },
  "style": "dist/css/main.css",
  "types": "src/ts/_build/_icons.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uq-its-ss/design-system.git"
  },
  "scripts": {
    "build": "npm run clean-icons && npm run build-icons && npm run format",
    "build-icons": "tsx src/ts/build-icons/index.ts",
    "clean": "npm run clean-icons",
    "clean-icons": "rm -rf ./dist/images src/*/_build/*",
    "format": "prettier --write \"**/*.{css,scss,js,jsx,json,md,mdx,tsx}\"",
    "prepare": "gulp -f ../../gulpfile.js --cwd=. prepare"
  },
  "bugs": {
    "url": "https://github.com/uq-its-ss/design-system/issues"
  },
  "dependencies": {
    "@uqds/core": "^5.0.2"
  },
  "devDependencies": {
    "@svgdotjs/svg.js": "^3.2.8",
    "@types/glob": "^7.2.0",
    "@types/node": "^17.0.45",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "glob": "^7.2.3",
    "gulp": "^5.0.1",
    "mini-svg-data-uri": "^1.4.4",
    "prettier": "^2.8.8",
    "svgdom": "0.1.28",
    "svgo": "^4.1.0",
    "tsx": "^4.23.13",
    "typescript": "^4.9.5"
  }
}
